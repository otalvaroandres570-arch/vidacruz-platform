# Local configuration for docker compose. Copy to .env, or simply run run.ps1 / run.sh,
# which create it with random secrets. The real .env is never committed.

POSTGRES_DB=triage_db
POSTGRES_USER=triage_user
POSTGRES_PASSWORD=

# API keys (at least 16 characters). The services refuse to start without them.
TRIAGE_SECURITY_APIKEYS=
ASSISTANT_SECURITY_APIKEYS=

# Optional. Without a Gemini key the assistant starts and answers 503 (degraded mode).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Optional. Where the images are built from. By default the sibling folders of this repository;
# to build straight from GitHub (no need to clone the services), for example:
# TRIAGE_CONTEXT=https://github.com/otalvaroandres570-arch/triage-vida-cruz.git#main
# ASSISTANT_CONTEXT=https://github.com/otalvaroandres570-arch/assistant-service.git#main