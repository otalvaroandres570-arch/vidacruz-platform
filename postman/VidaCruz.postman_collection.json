    {
      "name": "4. Asistente clínico (RF-04)",
      "description": "Las consultas clínicas necesitan GEMINI_API_KEY (incluso la búsqueda usa embeddings de Gemini). Sin ella, devuelven 503 ASSISTANT_UNAVAILABLE, y los tests lo aceptan como modo degradado.",
      "item": [
        {
          "name": "4.1 Vista de urgencias (construida solo con eventos de Kafka)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{assistantKey}}"
              }
            ],
            "url": {
              "raw": "{{assistantUrl}}/asistente/estado-urgencias",
              "host": [
                "{{assistantUrl}}"
              ],
              "path": [
                "asistente",
                "estado-urgencias"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// the events travel through the outbox and Kafka: give them a few seconds to reach the view",
                  "const wait = parseInt(pm.environment.get(\"kafkaWaitMs\") || \"8000\");",
                  "setTimeout(function () {}, wait);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 y la vista subió al menos en 2 con los pacientes registrados\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const view = pm.response.json();",
                  "    const baseline = parseInt(pm.environment.get(\"urgencyBaseline\"));",
                  "    pm.expect(Number.isNaN(baseline), \"run request 2.0 first\").to.eql(false);",
                  "    pm.expect(view.total).to.be.at.least(baseline + 2);",
                  "});",
                  "pm.test(\"informa los cinco niveles\", function () {",
                  "    const levels = pm.response.json().porNivel;",
                  "    [\"CRITICO\", \"URGENTE\", \"URGENTE_2\", \"NO_URGENTE\", \"NO_URGENTE_2\"].forEach(function (level) {",
                  "        pm.expect(levels).to.have.property(level);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Consulta con protocolo (con cita)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{assistantKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{assistantUrl}}/asistente/consulta",
              "host": [
                "{{assistantUrl}}"
              ],
              "path": [
                "asistente",
                "consulta"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pregunta\": \"¿Cuáles son las medidas iniciales ante una crisis hipertensiva?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function isDegraded() {",
                  "    if (pm.response.code !== 503) { return false; }",
                  "    pm.expect(pm.response.json().code).to.eql(\"ASSISTANT_UNAVAILABLE\");",
                  "    console.warn(\"Degraded mode: the Gemini key is missing or the provider is not answering\");",
                  "    return true;",
                  "}",
                  "",
                  "        pm.test(\"200 con respuesta y cita de PROTO-001, o 503 en modo degradado\", function () {",
                  "            if (isDegraded()) { return; }",
                  "            pm.response.to.have.status(200);",
                  "            const body = pm.response.json();",
                  "            pm.expect(body.respuesta.length).to.be.above(0);",
                  "            pm.expect(body.fuentes.map(function (source) { return source.protocolo; })).to.include(\"PROTO-001\");",
                  "            body.fuentes.forEach(function (source) {",
                  "                pm.expect(source).to.have.property(\"protocolo\");",
                  "                pm.expect(source).to.have.property(\"seccion\");",
                  "            });",
                  "        });"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Pregunta sin protocolo (sin alucinación)",
