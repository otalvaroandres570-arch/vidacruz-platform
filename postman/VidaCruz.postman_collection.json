    {
      "name": "3. Reporte de operación (RF-05)",
      "description": "Rango [desde, hasta) en UTC, máximo 31 días.",
      "item": [
        {
          "name": "3.1 Reporte del día (UTC)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              }
            ],
            "url": {
              "raw": "{{triageUrl}}/triage/reportes/operacion?desde={{reportFrom}}&hasta={{reportTo}}",
              "host": [
                "{{triageUrl}}"
              ],
              "path": [
                "triage",
                "reportes",
                "operacion"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "{{reportFrom}}"
                },
                {
                  "key": "hasta",
                  "value": "{{reportTo}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date();",
                  "start.setUTCHours(0, 0, 0, 0);",
                  "const end = new Date(start.getTime() + 24 * 3600 * 1000);",
                  "pm.environment.set(\"reportFrom\", start.toISOString());",
                  "pm.environment.set(\"reportTo\", end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 con un cuerpo JSON no vacío\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.response.to.be.json;",
                  "    pm.expect(pm.response.text().length).to.be.above(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Rango invertido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              }
            ],
            "url": {
              "raw": "{{triageUrl}}/triage/reportes/operacion?desde=2026-11-17T00:00:00Z&hasta=2026-11-16T00:00:00Z",
              "host": [
                "{{triageUrl}}"
              ],
              "path": [
                "triage",
                "reportes",
                "operacion"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "2026-11-17T00:00:00Z"
                },
                {
                  "key": "hasta",
                  "value": "2026-11-16T00:00:00Z"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 con el rango al revés\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().code).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Rango de más de 31 días",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              }
            ],
            "url": {
              "raw": "{{triageUrl}}/triage/reportes/operacion?desde=2026-01-01T00:00:00Z&hasta=2026-12-31T00:00:00Z",
              "host": [
                "{{triageUrl}}"
              ],
              "path": [
                "triage",
                "reportes",
                "operacion"
              ],
              "query": [
                {
