    {
      "name": "6. Escalamiento por SLA vencido (opcional)",
      "description": "Solo se ejecuta con runEscalation=true en el entorno, y necesita el triaje arrancado con TRIAGE_SLA_CRITICO=1 y TRIAGE_SLAMONITOR_INTERVAL=2s. La alerta (RF-06) se ve en el log: docker compose logs triage-service.",
      "item": [
        {
          "name": "6.1 Registrar un crítico y no atenderlo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{triageUrl}}/triage/pacientes",
              "host": [
                "{{triageUrl}}"
              ],
              "path": [
                "triage",
                "pacientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Paciente Escalamiento\",\n  \"age\": 40,\n  \"heartRate\": 130,\n  \"systolicBp\": 180,\n  \"diastolicBp\": 110,\n  \"spo2\": 97,\n  \"temperature\": 36.8,\n  \"pain\": 8,\n  \"gcs\": 15,\n  \"chiefComplaint\": \"Dolor toracico\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get(\"runEscalation\") !== \"true\") {",
                  "    // requires a recent Postman; otherwise, deselect this folder in the Collection Runner",
                  "    if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set(\"escalationPatientId\", pm.response.json().id);",
                  "}",
                  "pm.test(\"201 y CRITICO\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().nivel).to.eql(\"CRITICO\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Esperar el SLA y comprobar el escalamiento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              }
            ],
            "url": {
              "raw": "{{triageUrl}}/triage/pacientes/{{escalationPatientId}}",
              "host": [
                "{{triageUrl}}"
              ],
              "path": [
                "triage",
                "pacientes",
                "{{escalationPatientId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get(\"runEscalation\") !== \"true\") {",
                  "    // requires a recent Postman; otherwise, deselect this folder in the Collection Runner",
                  "    if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }",
                  "}",
                  "",
                  "        if (pm.environment.get(\"runEscalation\") === \"true\") {",
                  "            // 1 minute of SLA plus the monitor interval",
                  "            const wait = parseInt(pm.environment.get(\"escalationWaitMs\") || \"75000\");",
                  "            setTimeout(function () {}, wait);",
                  "        }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"el paciente quedó escalado y sigue en REGISTRADO\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const patient = pm.response.json();",
                  "    pm.expect(patient.escalado).to.eql(true);",
                  "    pm.expect(patient.fechaEscalamiento).to.be.a(\"string\");",
                  "    pm.expect(patient.estado).to.eql(\"REGISTRADO\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
