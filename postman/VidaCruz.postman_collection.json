    {
      "name": "2. Triaje: registro y estados (RF-01, RF-02)",
      "description": "Ejecutar en orden: el escenario 2.2 guarda el patientId que usan los siguientes.",
      "item": [
        {
          "name": "2.0 Línea base de la vista de urgencias (asistente)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{assistantKey}}"
              }
            ],
            "url": {
              "raw": "{{assistantUrl}}/asistente/estado-urgencias",
              "host": [
                "{{assistantUrl}}"
              ],
              "path": [
                "asistente",
                "estado-urgencias"
              ]
            },
            "description": "Se guarda el total actual para comprobar más tarde que los eventos de Kafka llegaron a la vista."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 y total numérico (se guarda como línea base)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const view = pm.response.json();",
                  "    pm.expect(view.total).to.be.a(\"number\");",
                  "    pm.environment.set(\"urgencyBaseline\", String(view.total));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.1 Registrar paciente crítico (caso E1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{triageUrl}}/triage/pacientes",
              "host": [
                "{{triageUrl}}"
              ],
              "path": [
                "triage",
                "pacientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Juan Perez\",\n  \"age\": 40,\n  \"heartRate\": 130,\n  \"systolicBp\": 180,\n  \"diastolicBp\": 110,\n  \"spo2\": 97,\n  \"temperature\": 36.8,\n  \"pain\": 8,\n  \"gcs\": 15,\n  \"chiefComplaint\": \"Dolor toracico\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set(\"patientId\", pm.response.json().id);",
                  "}",
                  "pm.test(\"201, CRITICO, con su SLA y en REGISTRADO\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const patient = pm.response.json();",
                  "    pm.expect(patient.nivel).to.eql(\"CRITICO\");",
                  "    pm.expect(patient.slaMinutos).to.eql(parseInt(pm.environment.get(\"expectedCriticalSla\") || \"5\"));",
                  "    pm.expect(patient.estado).to.eql(\"REGISTRADO\");",
                  "    pm.expect(patient.escalado).to.eql(false);",
                  "    pm.expect(patient.id).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Registrar paciente urgente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{triageUrl}}/triage/pacientes",
              "host": [
                "{{triageUrl}}"
              ],
              "path": [
                "triage",
                "pacientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ana Gomez\",\n  \"age\": 35,\n  \"heartRate\": 95,\n  \"systolicBp\": 150,\n  \"diastolicBp\": 95,\n  \"spo2\": 91,\n  \"temperature\": 37.0,\n  \"pain\": 4,\n  \"gcs\": 15,\n  \"chiefComplaint\": \"Dificultad para respirar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 y clasificado como URGENTE\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const patient = pm.response.json();",
                  "    pm.expect(patient.nivel).to.eql(\"URGENTE\");",
                  "    pm.expect(patient.slaMinutos).to.be.a(\"number\").and.above(0);",
                  "    pm.expect(patient.estado).to.eql(\"REGISTRADO\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Registrar paciente no urgente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              },
              {
                "key": "Content-Type",
