            ],
            "url": {
              "raw": "{{triageUrl}}/triage/pacientes",
              "host": [
                "{{triageUrl}}"
              ],
              "path": [
                "triage",
                "pacientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dato Invalido\",\n  \"age\": 40,\n  \"heartRate\": 130,\n  \"systolicBp\": 180,\n  \"diastolicBp\": 110,\n  \"spo2\": 101,\n  \"temperature\": 36.8,\n  \"pain\": 8,\n  \"gcs\": 15,\n  \"chiefComplaint\": \"Dolor toracico\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 señalando el campo spo2\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.be.a(\"string\");",
                  "    pm.expect(JSON.stringify(body.violations)).to.include(\"spo2\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Consultar el paciente crítico",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              }
            ],
            "url": {
              "raw": "{{triageUrl}}/triage/pacientes/{{patientId}}",
              "host": [
                "{{triageUrl}}"
              ],
              "path": [
                "triage",
                "pacientes",
                "{{patientId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 con los campos del enunciado\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const patient = pm.response.json();",
                  "    pm.expect(patient.id).to.eql(pm.environment.get(\"patientId\"));",
                  "    [\"nivel\", \"slaMinutos\", \"estado\", \"fechaRegistro\", \"escalado\"].forEach(function (field) {",
                  "        pm.expect(patient).to.have.property(field);",
                  "    });",
                  "    pm.expect(patient.estado).to.eql(\"REGISTRADO\");",
                  "    pm.expect(Object.keys(patient).some(function (key) { return key.indexOf(\"tiempoEnEstado\") === 0; }),",
                  "        \"time in the current status\").to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
