            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Luis Rios\",\n  \"age\": 28,\n  \"heartRate\": 72,\n  \"systolicBp\": 120,\n  \"diastolicBp\": 80,\n  \"spo2\": 99,\n  \"temperature\": 36.5,\n  \"pain\": 2,\n  \"gcs\": 15,\n  \"chiefComplaint\": \"Herida por cortar\"\n}",
