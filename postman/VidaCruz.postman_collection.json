          ]
        },
        {
          "name": "2.4 Validación: saturación fuera de rango",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{triageKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
